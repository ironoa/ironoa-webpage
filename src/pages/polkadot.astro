import Base from '../layouts/Base.astro';
---
<Base title="Polkadot — ironoa" description="ironoa Polkadot validation has been retired; Kusama validation continues.">
  <h1 class="h1"><img src="/polkadot-icon.png" alt="Polkadot" style="width: 32px; height: 32px; display: inline-block; vertical-align: middle; margin-right: 0.5rem;" /> Polkadot Validator — Retired</h1>

  <div class="panel">
    <p>Our Polkadot validator <code>ALESSIO</code> was wound down in July 2026, following the
    <a href="https://medium.com/web3foundation/web3-foundation-is-sunsetting-the-decentralized-nodes-program-761b70b1a468" target="_blank" rel="noreferrer" style="text-decoration: underline;">sunset of the Web3 Foundation's Decentralized Nodes program</a> —
    the initiative that sustained independent, self-hosted validators like ours on Polkadot.</p>
    <p style="margin-top:.75rem;">It operated since 2020 with zero slashing incidents, from self-hosted
    infrastructure in Southern Switzerland.</p>
    <p style="margin-top:.75rem;">Our validation continues on <a href="/kusama" style="text-decoration: underline;">Kusama</a>.</p>
  </div>
</Base>
